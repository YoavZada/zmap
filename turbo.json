{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".npmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["BASE_PATH", "VITE_*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "e2e": {
      "cache": false,
      "env": ["CI", "E2E_BASE_URL", "BASE_PATH", "VITE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
