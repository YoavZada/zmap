{
  "name": "zmap-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "zmap — MUI-native map components built on MapLibre GL",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:lib": "turbo run build --filter=zmapgl",
    "dev": "turbo run dev --filter=zmapgl",
    "docs": "turbo run dev --filter=docs",
    "pathfinder": "turbo run dev --filter=pathfinder",
    "test": "turbo run test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "turbo": "^2.10.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0"
}
