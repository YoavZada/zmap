{
  "name": "zmap-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "zmap — MUI-native map components built on MapLibre GL",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:lib": "turbo run build --filter=zmapgl",
    "dev": "turbo run dev --filter=zmapgl",
    "docs": "turbo run dev --filter=docs",
    "pathfinder": "turbo run dev --filter=pathfinder",
    "test": "turbo run test",
    "e2e": "turbo run e2e --filter=@zmap/e2e",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "release": "pnpm --filter zmapgl build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@9.15.0"
}
